{
  "name": "graphql-lambdas",
  "version": "1.0.0",
  "private": true,
  "description": "AppSync GraphQL resolver Lambdas (queries, mutations, subscriptions) + DB migrations",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "serverless package --stage ${STAGE:-prod}",
    "deploy": "serverless deploy --stage ${STAGE:-prod}"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1170.0",
    "@aws-sdk/rds-signer": "^3.1170.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "serverless": "^3.40.0",
    "serverless-appsync-plugin": "^2.13.0",
    "serverless-esbuild": "^1.57.3",
    "serverless-iam-roles-per-function": "^3.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
