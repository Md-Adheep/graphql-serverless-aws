# Copy to terraform.tfvars for local runs (git-ignored). In CI these come from GitHub vars/secrets.
aws_region  = "us-east-2"
alert_email = "you@example.com"

# Optional custom domain for CloudFront (leave empty to use the *.cloudfront.net URL)
domain_name = ""

# Production hardening (more cost):
# single_nat_gateway     = false
# db_multi_az            = true
# db_create_read_replica = true
# allow_destroy          = false
